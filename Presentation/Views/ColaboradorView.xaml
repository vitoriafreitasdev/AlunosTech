<UserControl x:Class="Presentation.Views.ColaboradorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F4F6F9">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Navegação -->
        <TabControl Grid.Row="1"
                Margin="25,0,25,25"
                FontSize="14">

            <!-- ABA DE CADASTRO -->
            <TabItem Header="Cadastrar colaborador">

                <Grid Margin="25">

                    <StackPanel Width="400"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top">

                        <TextBlock Text="Novo colaborador"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="0,0,0,20"/>

                        <TextBlock Text="Nome"/>
                        <TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}"
                             Height="35"
                             Margin="0,5,0,15"/>

                        <TextBlock Text="E-mail"/>
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             Height="35"
                             Margin="0,5,0,15"/>

                        <TextBlock Text="Cargo"/>
                        <TextBox Text="{Binding Cargo, UpdateSourceTrigger=PropertyChanged}"
                             Height="35"
                             Margin="0,5,0,15"/>

                        <TextBlock Text="Salário"/>
                        <TextBox Text="{Binding Salario, UpdateSourceTrigger=PropertyChanged}"
                             Height="35"
                             Margin="0,5,0,15"/>

                        <TextBlock Text="Data de contratação"/>
                        <DatePicker SelectedDate="{Binding DataContratacao}"
                                Height="35"
                                Margin="0,5,0,20"/>

                        <Button Content="Cadastrar colaborador"
                            Command="{Binding CadastrarCommand}"
                            Height="40"
                            Background="#1976D2"
                            Foreground="White"
                            FontWeight="Bold"/>

                        <TextBlock Text="{Binding Mensagem}"
                               Margin="0,15,0,0"
                               TextWrapping="Wrap"/>

                    </StackPanel>

                </Grid>

            </TabItem>

            <!-- ABA DE LISTAGEM -->
            <TabItem Header="Colaboradores cadastrados">

                <Grid Margin="20">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Cabeçalho da listagem -->
                    <DockPanel Margin="0,0,0,15">

                        <TextBlock Text="Colaboradores registrados"
                               FontSize="21"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>

                        <Button Content="Atualizar lista"
                            Command="{Binding CarregarColaboradoresCommand}"
                            Width="130"
                            Height="35"
                            DockPanel.Dock="Right"
                            Background="#1976D2"
                            Foreground="White"/>

                    </DockPanel>

                    <!-- Tabela -->
                    <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Colaboradores}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          AlternatingRowBackground="#EDF2F7"
                          GridLinesVisibility="Horizontal">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Nome"
                                            Binding="{Binding Nome}"
                                            Width="2*"/>

                            <DataGridTextColumn Header="E-mail"
                                            Binding="{Binding Email}"
                                            Width="2*"/>

                            <DataGridTextColumn Header="Cargo"
                                            Binding="{Binding Cargo}"
                                            Width="*"/>

                            <DataGridTextColumn Header="Salário"
                                            Binding="{Binding Salario, StringFormat={}{0:C}}"
                                            Width="*"/>

                            <DataGridTextColumn Header="Contratação"
                                            Binding="{Binding DataContratacao, StringFormat={}{0:dd/MM/yyyy}}"
                                            Width="*"/>

                        </DataGrid.Columns>

                    </DataGrid>

                    <!-- Mensagem -->
                    <TextBlock Grid.Row="2"
                           Text="{Binding Mensagem}"
                           Margin="0,12,0,0"
                           TextWrapping="Wrap"/>

                </Grid>

            </TabItem>

        </TabControl>

    </Grid>

</UserControl>

